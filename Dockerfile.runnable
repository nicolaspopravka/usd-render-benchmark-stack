ARG PRISTINE_IMAGE
FROM ${PRISTINE_IMAGE}
ARG BASE_NAME
LABEL org.opencontainers.image.title="usd-render-benchmark-runnable" \
      org.opencontainers.image.description="Benchmark runtime conventions on the selected pristine stack." \
      org.opencontainers.image.base.name="${BASE_NAME}" \
      org.opencontainers.image.base.digest=""
ENV REZ_PACKAGES_PATH=./packages
WORKDIR /
ENTRYPOINT []
CMD ["bash", "render_script.sh"]
