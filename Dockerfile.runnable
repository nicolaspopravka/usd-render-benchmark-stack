# syntax=docker/dockerfile:1.10

# Runnable environment overlay: the pristine stack plus run conventions
# (runtime-selected workdir + default command + rez packages path).
# publish -> ghcr.io/nicolaspopravka/usd-render-benchmark:<cy>

# Two stages: the build selects one with --target. runnable-base is a plain
# overlay of the pristine image; runnable-cycles adds the Cycles plugin path
# and nothing else. A pristine built without Cycles targets runnable-base and
# so carries no PXR_PLUGINPATH_NAME at all, rather than an empty or dangling one.

ARG PRISTINE_IMAGE

FROM ${PRISTINE_IMAGE} AS runnable-base

# Image identity, same block as Dockerfile.pristine with this package's name.
# Repeated so the overlay is correct even when built FROM a raw ASWF base.
ARG IMAGE_VERSION=""
ARG BUILD_CREATED=""
ARG BASE_NAME=""
ARG BASE_DIGEST=""
LABEL org.opencontainers.image.title="usd-render-benchmark: Hydra render delegate benchmark images" \
      org.opencontainers.image.description="Benchmark images that render USD scenes with Hydra render delegates: Storm, plus MoonRay, Cycles or Embree depending on the tag. The image supplies the software environment; a benchmark run branch supplies the harness, scenes and outputs." \
      org.opencontainers.image.name="usd-render-benchmark" \
      org.opencontainers.image.source="https://github.com/nicolaspopravka/usd-render-benchmark-stack" \
      org.opencontainers.image.url="https://github.com/nicolaspopravka/usd-render-benchmark" \
      org.opencontainers.image.authors="Nicolas Popravka" \
      org.opencontainers.image.vendor="usd-render-benchmark" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.created="${BUILD_CREATED}" \
      org.opencontainers.image.revision="" \
      org.opencontainers.image.base.name="${BASE_NAME}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}"

ENV REZ_PACKAGES_PATH=./packages

WORKDIR /

ENTRYPOINT []
CMD ["bash", "render_script.sh"]

# Cycles is not an ASWF project: it installs under /opt/cycles, outside the
# base's compiled-in plugin root, so it needs an explicit search path. The
# pristine image defines no PXR_PLUGINPATH_NAME, so this sets rather than
# extends it. Select this stage only when the pristine image built Cycles.
FROM runnable-base AS runnable-cycles

ENV PXR_PLUGINPATH_NAME=/opt/cycles/hydra
