# syntax=docker/dockerfile:1.10

# Runnable environment overlay: the pristine stack plus run conventions
# (runtime-selected workdir + default command + rez packages path).

ARG PRISTINE_IMAGE

FROM ${PRISTINE_IMAGE}

# Image identity, restated from Dockerfile.pristine with this package's own
# name. The values are normally inherited, because this workflow builds FROM the
# pristine image; they are set again so the overlay is still correct when
# pristine_image points at a raw ASWF base, which the workflow permits. The
# build args are re-declared here because they do not cross FROM. See
# Dockerfile.pristine for why version is a build arg and why created/revision
# are left alone.
ARG IMAGE_TAG=""
LABEL org.opencontainers.image.title="usd-render-benchmark: Hydra render delegate benchmark images" \
      org.opencontainers.image.description="Benchmark images that render USD scenes with Hydra render delegates: Storm, plus MoonRay, Cycles or Embree depending on the tag. The image supplies the software environment; a benchmark run branch supplies the harness, scenes and outputs." \
      org.opencontainers.image.name="usd-render-benchmark" \
      org.opencontainers.image.source="https://github.com/nicolaspopravka/usd-render-benchmark-stack" \
      org.opencontainers.image.url="https://github.com/nicolaspopravka/usd-render-benchmark" \
      org.opencontainers.image.authors="Nicolas Popravka" \
      org.opencontainers.image.vendor="usd-render-benchmark" \
      org.opencontainers.image.version="${IMAGE_TAG}"

ENV REZ_PACKAGES_PATH=./packages

WORKDIR /

ENTRYPOINT []
CMD ["bash", "render_script.sh"]

# TEMPORARY: rez PATH — drop when aswf-docker #467 lands in the base.
ENV PATH=/usr/local/rez/bin/rez:${PATH}

# TEMPORARY: pxr lives in /usr/local/lib/python on most CYs (site-packages on
# CY2027). Harmless on 2027; drop the fix when the bases all ship site-packages.
ENV PYTHONPATH=/usr/local/lib/python

# TEMPORARY: MoonRay/Embree plugin lookup — the composed delegates live outside
# the compiled-in plugin/usd root (MoonRay under /usr/local/plugin/pxr); the
# runnable must expose them so a stock usdrecord enumerates all delegates.
# Cycles is not an ASWF project: it installs under /opt/cycles and is activated
# here the same way.
ENV PXR_PLUGINPATH_NAME=/usr/local/plugin/pxr:/opt/cycles/hydra
# TEMPORARY: Arras session dir — drop when OpenMoonRay lands in the base.
ENV ARRAS_SESSION_PATH=/usr/local/sessions

# TEMPORARY: Export shader_json from the installed MoonRay DSOs for the Hydra
# Ndr plugins (the runnable's analogue of the doc's setup.sh). Drop when
# OpenMoonRay lands in the base.
RUN if command -v rdl2_json_exporter >/dev/null 2>&1; then \
      export PATH=/usr/local/bin:$PATH \
             LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH:-} \
             MOONRAY_ROOT=/usr/local \
             RDL2_DSO_PATH=/usr/local/rdl2dso.proxy:/usr/local/rdl2dso \
             MOONRAY_CLASS_PATH=/usr/local/shader_json \
      && mkdir -p /usr/local/shader_json \
      && rdl2_json_exporter --out /usr/local/shader_json/ --sparse; \
    fi

# GH #49 workaround: usdrecord's 'Storm'/'GL' tokens alias to a display name
# that never matches (v25.05 rendererArgs ResolveStormAlias vs the Engine's
# 'Storm'-hack), so they fall back to the *default* renderer — which becomes
# Cycles once it enumerates first. Pin the engine default to hdStorm: its
# registry plugInfo displayName is "GL" (the engine's "Storm" is only a
# display-name surface), so HD_DEFAULT_RENDERER must be "GL" to match.
# Drop when usdrecord fixes the alias.
ENV HD_DEFAULT_RENDERER=GL
