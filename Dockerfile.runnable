# syntax=docker/dockerfile:1.10

# Runnable environment overlay: the pristine stack plus run conventions
# (workdir + entrypoint + rez packages path).
# publish -> ghcr.io/nicolaspopravka/usd-render-benchmark:<cy>

ARG PRISTINE_IMAGE

FROM ${PRISTINE_IMAGE}

ENV REZ_PACKAGES_PATH=/usr/local/usd-render-benchmark/packages

WORKDIR /usr/local/usd-render-benchmark

ENTRYPOINT ["bash", "render_script.sh"]
CMD []
# TEMPORARY: MoonRay plugin discovery — drop when OpenMoonRay lands in the base.
ENV PXR_PLUGINPATH_NAME=/usr/local/plugin/pxr
# TEMPORARY: Arras session dir — drop when OpenMoonRay lands in the base.
ENV ARRAS_SESSION_PATH=/usr/local/sessions
# TEMPORARY: OpenMoonRay install root — drop when OpenMoonRay lands in the base.
# OpenMoonRay locates its OptiX GPU programs under its install root
# (${MOONRAY_ROOT}/shaders), preferring REZ_MOONRAY_ROOT and falling back to
# MOONRAY_ROOT. Rez sets REZ_MOONRAY_ROOT to the package directory rather than
# the install root, so without this the GPU programs are not found and XPU mode
# is never entered. Not an execution setting: the image still does not select a
# device, so this only makes the built GPU support reachable.
ENV MOONRAY_ROOT=/usr/local
