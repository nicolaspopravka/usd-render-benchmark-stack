# syntax=docker/dockerfile:1.10

# Runnable environment overlay: the pristine stack plus run conventions
# (workdir + entrypoint + rez packages path).
# publish -> ghcr.io/nicolaspopravka/usd-render-benchmark:<cy>

ARG PRISTINE_IMAGE

FROM ${PRISTINE_IMAGE}

ENV REZ_PACKAGES_PATH=/usr/local/usd-render-benchmark/packages

WORKDIR /usr/local/usd-render-benchmark

ENTRYPOINT ["bash", "render_script.sh"]
CMD []

# TEMPORARY: rez PATH — drop when aswf-docker #467 lands in the base.
ENV PATH=/usr/local/rez/bin/rez:${PATH}

# TEMPORARY: pxr lives in /usr/local/lib/python on most CYs (site-packages on
# CY2027). Harmless on 2027; drop the fix when the bases all ship site-packages.
ENV PYTHONPATH=/usr/local/lib/python

# TEMPORARY: MoonRay/Embree plugin lookup — the composed delegates live outside
# the compiled-in plugin/usd root (MoonRay under /usr/local/plugin/pxr); the
# runnable must expose them so a stock usdrecord enumerates all delegates.
ENV PXR_PLUGINPATH_NAME=/usr/local/plugin/pxr
# TEMPORARY: Arras session dir — drop when OpenMoonRay lands in the base.
ENV ARRAS_SESSION_PATH=/usr/local/sessions

# Cycles OSL shader support data (native-node benchmark scenes need none; this
# only makes OSL-capable setups resolve).
ENV CYCLES_SHADER_PATH=/usr/local/share/cycles/shader

# Export shader_json from the installed MoonRay DSOs for the Hydra Ndr plugins
# (the runnable's analogue of the doc's setup.sh). Only on MoonRay years.
RUN if command -v rdl2_json_exporter >/dev/null 2>&1; then \
      export PATH=/usr/local/bin:$PATH \
             LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH:-} \
             MOONRAY_ROOT=/usr/local \
             RDL2_DSO_PATH=/usr/local/rdl2dso.proxy:/usr/local/rdl2dso \
             MOONRAY_CLASS_PATH=/usr/local/shader_json \
      && mkdir -p /usr/local/shader_json \
      && rdl2_json_exporter --out /usr/local/shader_json/ --sparse; \
    fi

# Build-time evidence: the renderer set the runnable enumerates (non-gating
# print; the PXR_PLUGINPATH_NAME above is what makes MoonRay appear).
RUN pxr_dir=$(find /usr/local/lib -maxdepth 4 -type d -name pxr -print -quit) \
    && test -n "$pxr_dir" \
    && PYTHONPATH="$(dirname "$pxr_dir")" python3 -c 'from pxr import UsdImagingGL; names=[UsdImagingGL.Engine.GetRendererDisplayName(p) for p in UsdImagingGL.Engine.GetRendererPlugins()]; print("runnable renderers:", names)' || true
