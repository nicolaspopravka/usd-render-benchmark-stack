# syntax=docker/dockerfile:1.10

# Runnable environment overlay: the pristine stack plus run conventions
# (runtime-selected workdir + default command + rez packages path).
# publish -> ghcr.io/nicolaspopravka/usd-render-benchmark:<cy>

# Two stages: the build selects one with --target. runnable-base is a plain

ARG PRISTINE_IMAGE

FROM ${PRISTINE_IMAGE} AS runnable-base

ENV REZ_PACKAGES_PATH=./packages

WORKDIR /

ENTRYPOINT []
CMD ["bash", "render_script.sh"]

# Cycles is not an ASWF project: it installs under /opt/cycles, outside the
# base's compiled-in plugin root, so it needs an explicit search path. The
# pristine image defines no PXR_PLUGINPATH_NAME, so this sets rather than
# extends it. Select this stage only when the pristine image built Cycles.
FROM runnable-base AS runnable-cycles

ENV PXR_PLUGINPATH_NAME=/opt/cycles/hydra
