FROM prepared AS embree
COPY cmake/hdembree-consumer /usr/local/aswf/cmake/hdembree-consumer
COPY build_hdembree.sh /usr/local/aswf/build_hdembree.sh
RUN bash -ec 'source /usr/local/aswf/build-support/vfx-cxx.sh; \
    vfx_cxx_environment; \
    export OPENUSD_TAG="v${ASWF_OPENUSD_VERSION}" DESTDIR=/opt/install; \
    bash /usr/local/aswf/build_hdembree.sh; \
    rm -rf /opt/build-hdembree'
