FROM prepared AS embree
COPY cmake/hdembree-consumer /usr/local/aswf/cmake/hdembree-consumer
COPY build_hdembree.sh /usr/local/aswf/build_hdembree.sh
RUN OPENUSD_TAG="v${ASWF_OPENUSD_VERSION:?Exact USD source version must be recovered from the base before building}" \
    bash /usr/local/aswf/build-support/run-build.sh /usr/local/aswf/build_hdembree.sh && \
    rm -rf /opt/build-hdembree
