# syntax=docker/dockerfile:1.10

# Byte-pristine <cy> stack image.
#
# CYCLES_TAG empty (default) keeps this a pure retag. When CYCLES_TAG is set,
# the Cycles Hydra delegate is built under /opt/cycles with this CY's
# VFX-Platform compiler.

ARG BASE_IMAGE

FROM ${BASE_IMAGE}
ARG CXX_CONFORMANCE="off"

# Image identity, overriding the ASWF base's labels, which we inherit. version
# is a build arg because the base's value is the ASWF version, not ours.
# image.name is not a predefined OCI annotation and the namespace is reserved;
# it is kept as a legacy label because it is the only thing naming the package.
ARG IMAGE_VERSION=""
ARG BUILD_CREATED=""
ARG BASE_NAME=""
ARG BASE_DIGEST=""
LABEL org.opencontainers.image.title="usd-render-benchmark: Hydra render delegate benchmark images" \
      org.opencontainers.image.description="Benchmark images that render USD scenes with Hydra render delegates: Storm, plus MoonRay, Cycles or Embree depending on the tag. The image supplies the software environment; a benchmark run branch supplies the harness, scenes and outputs." \
      org.opencontainers.image.name="usd-render-benchmark-stack" \
      org.opencontainers.image.source="https://github.com/nicolaspopravka/usd-render-benchmark-stack" \
      org.opencontainers.image.url="https://github.com/nicolaspopravka/usd-render-benchmark" \
      org.opencontainers.image.authors="Nicolas Popravka" \
      org.opencontainers.image.vendor="usd-render-benchmark" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.created="${BUILD_CREATED}" \
      org.opencontainers.image.revision="" \
      org.opencontainers.image.base.name="${BASE_NAME}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}"

ARG CYCLES_TAG=""
ARG CYCLES_REPO=""
ARG WITH_CYCLES_OSL="ON"
ARG WITH_CYCLES_OPENVDB="ON"

ARG MOONRAY_REPO=""
ARG MOONRAY_TAG=""
ARG MOONRAY_TOOLSET=""

# TEMPORARY: additions the ASWF base needs before the default build can work.
# 05 installs the OSL shader includes the conan OSL package omits, so
# WITH_CYCLES_OSL defaults to ON; select OFF explicitly for bases whose OSL
# compiler cannot load its runtime dependencies.
#
# This .3 pristine is built FROM stack:<cy>.2, which already carries Rez and
# GNU time from the .2 composer, so neither is installed here.
COPY fixers/ /usr/local/aswf/cycles-fixers/
RUN /usr/local/aswf/cycles-fixers/05-osl-shader-includes.sh

COPY build_cycles.sh /usr/local/aswf/build_cycles.sh
COPY build-support/ /usr/local/aswf/build-support/
COPY cmake/import_openusd_dependencies.cmake /usr/local/share/cycles/import_openusd_dependencies.cmake
RUN if [ -n "${CYCLES_TAG}" ]; then \
      bash -lc 'source /opt/rh/gcc-toolset-${ASWF_DTS_VERSION}/enable && \
                source /usr/local/aswf/build-support/vfx-cxx.sh && \
                vfx_cxx_environment && \
                chmod +x /usr/local/aswf/build_cycles.sh && \
                CYCLES_TAG="${CYCLES_TAG}" \
                CYCLES_REPO="${CYCLES_REPO}" \
                WITH_CYCLES_OSL="${WITH_CYCLES_OSL}" \
                WITH_CYCLES_OPENVDB="${WITH_CYCLES_OPENVDB}" \
                /usr/local/aswf/build_cycles.sh && \
                vfx_cxx_check /opt/build-cycles/cycles/build && \
                rm -rf /opt/build-cycles'; \
    fi

# TEMPORARY: build OpenMoonRay into the pristine stack — drop when the ASWF
# base images ship OpenMoonRay (ASWF pins ASWF_MOONRAY_VERSION=3.6.0.1; the
# script rebuilds the tagged release against this base). MOONRAY_TAG empty
# keeps this a pure retag. The four fixers are MoonRay's own gaps (git-lfs,
# the deployed OpenUSD cmake exports, the unrunnable deployed ispc, and — when
# MOONRAY_TOOLSET is set — the compiler toolset the build runs with); each is
# a no-op when its gap is not present.
COPY fixers/01-gitlfs-prereqs.sh fixers/02-openusd-cmake-exports.sh \
     fixers/03-ispc.sh fixers/04-moonray-toolset.sh /usr/local/aswf/moonray-fixers/
COPY build_moonray.sh /usr/local/aswf/build_moonray.sh
RUN if [ -n "${MOONRAY_TAG}" ]; then \
      bash -ec 'source /usr/local/aswf/build-support/vfx-cxx.sh; \
                vfx_select_year; vfx_check_requested_toolset "${MOONRAY_TOOLSET}"'; \
    fi
RUN if [ -n "${MOONRAY_TAG}" ]; then \
      chmod +x /usr/local/aswf/moonray-fixers/*.sh /usr/local/aswf/build_moonray.sh && \
      /usr/local/aswf/moonray-fixers/01-gitlfs-prereqs.sh && \
      /usr/local/aswf/moonray-fixers/02-openusd-cmake-exports.sh && \
      /usr/local/aswf/moonray-fixers/03-ispc.sh && \
      MOONRAY_TOOLSET="${MOONRAY_TOOLSET}" \
      /usr/local/aswf/moonray-fixers/04-moonray-toolset.sh && \
      if [ -n "${MOONRAY_TOOLSET}" ]; then \
        export CC="/opt/rh/${MOONRAY_TOOLSET}/root/usr/bin/gcc" \
               CXX="/opt/rh/${MOONRAY_TOOLSET}/root/usr/bin/g++" \
               CUDA_HOST_COMPILER="/opt/rh/${MOONRAY_TOOLSET}/root/usr/bin/g++"; \
      fi; \
      MOONRAY_REPO_URL="${MOONRAY_REPO}" \
      MOONRAY_TAG="${MOONRAY_TAG}" \
      bash -ec 'source /usr/local/aswf/build-support/vfx-cxx.sh; \
                vfx_cxx_environment "${MOONRAY_TOOLSET}"; \
                bash /usr/local/aswf/build_moonray.sh; \
                vfx_cxx_check /opt/build-moonray/build; \
                rm -rf /opt/build-moonray'; \
    fi
