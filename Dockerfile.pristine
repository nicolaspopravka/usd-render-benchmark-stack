# syntax=docker/dockerfile:1.10

# Byte-pristine <cy> stack image — the ASWF base plus the overlays carried by
# the fix/* branches.

ARG BASE_IMAGE

FROM ${BASE_IMAGE}

# TEMPORARY: build OpenMoonRay into the pristine stack — drop when the ASWF
# base images ship OpenMoonRay (ASWF pins ASWF_MOONRAY_VERSION=3.6.0.1 on all
# years; the script rebuilds the tagged release against this base). Follows the
# official Rocky 9 container build; see build_moonray.sh.
ARG MOONRAY_TAG
COPY build_moonray.sh /usr/local/aswf/build_moonray.sh
RUN MOONRAY_TAG="${MOONRAY_TAG}" /usr/local/aswf/build_moonray.sh
