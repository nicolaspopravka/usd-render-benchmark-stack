ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG IMAGE_VERSION
ARG BUILD_CREATED
ARG RECIPE_REVISION
ARG BASE_NAME
ARG BASE_DIGEST
LABEL org.opencontainers.image.title="usd-render-benchmark-pristine" \
      org.opencontainers.image.source="https://github.com/nicolaspopravka/usd-render-benchmark-stack" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.created="${BUILD_CREATED}" \
      org.opencontainers.image.revision="${RECIPE_REVISION}" \
      org.opencontainers.image.base.name="${BASE_NAME}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      org.opencontainers.image.authors="Nicolas Popravka" \
      org.opencontainers.image.vendor="Nicolas Popravka" \
      org.opencontainers.image.url="https://github.com/nicolaspopravka/usd-render-benchmark-stack" \
      org.opencontainers.image.description="Annual ASWF stack for the USD Render Benchmark."

ARG CXX_CONFORMANCE=off
COPY build-support/vfx-cxx.sh /usr/local/aswf/build-support/vfx-cxx.sh
RUN bash -lc 'source /usr/local/aswf/build-support/vfx-cxx.sh && \
    vfx_cxx_environment && \
    echo "C++ build settings: gcc-toolset-${VFX_GCC_TOOLSET}, standard=${VFX_CXX_STANDARD:-default}"'
