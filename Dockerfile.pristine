# syntax=docker/dockerfile:1.10

# Byte-pristine <cy> stack image — the ASWF base plus the overlays carried by
# the fix/* branches.

ARG BASE_IMAGE

# TEMPORARY: build Rez in this stage — drop when aswf-docker #467 ships it in the base.
FROM ${BASE_IMAGE} AS rez-builder
COPY install_rez.sh /usr/local/bin/install_rez.sh
ENV REZ_INSTALL_DIR=/usr/local/rez
RUN bash -lc 'source /usr/local/bin/install_rez.sh && rez --version'

FROM ${BASE_IMAGE}

# TEMPORARY: Rez from rez-builder — drop when aswf-docker #467 ships it in the base.
COPY --from=rez-builder /usr/local/rez /usr/local/rez

# TEMPORARY: GNU time for render_script.sh — drop when aswf-docker #468 reaches the base.
RUN test -x /usr/bin/time || (dnf install -y time && dnf clean all && rm -rf /var/cache/dnf)

# TEMPORARY: Step-1 prereqs the base omits (install_packages.sh installs
# git-lfs) — drop when git-lfs ships in the ASWF base images.
COPY fixers/ /usr/local/aswf/moonray-fixers/
RUN /usr/local/aswf/moonray-fixers/01-gitlfs-prereqs.sh

# TEMPORARY: OpenUSD cmake exports reference CONAN_LIB targets the deploy never
# defines — drop when the ASWF bases ship corrected exports.
RUN /usr/local/aswf/moonray-fixers/02-openusd-cmake-exports.sh

# TEMPORARY: deployed conan ispc unrunnable (LLVM runtime omitted) — drop when
# the ASWF bases ship a runnable ispc.
RUN /usr/local/aswf/moonray-fixers/03-ispc.sh

# TEMPORARY: build OpenMoonRay into the pristine stack — drop when the ASWF
# base images ship OpenMoonRay (ASWF pins ASWF_MOONRAY_VERSION=3.6.0.1 on all
# years; the script rebuilds the tagged release against this base). Follows the
# official Rocky 9 container build; see build_moonray.sh.
ARG MOONRAY_TAG
# Candidate patches, applied only when this build asks for them (validation of an
# upstream fix). Empty by default, so a normal build applies nothing.
ARG MOONRAY_PATCHES_DIR=""
COPY build_moonray.sh /usr/local/aswf/build_moonray.sh
COPY patches/ /usr/local/aswf/patches/
RUN MOONRAY_TAG="${MOONRAY_TAG}" \
    MOONRAY_PATCHES_DIR="${MOONRAY_PATCHES_DIR}" \
    /usr/local/aswf/build_moonray.sh
