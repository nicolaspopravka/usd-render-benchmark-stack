# syntax=docker/dockerfile:1.10

# Byte-pristine <cy> stack image: base plus the hdEmbree delegate built and
# installed into the compiled-in plugin root (/usr/local/plugin/usd), where a
# USD build with hdEmbree enabled would have put it. No PXR_PLUGINPATH_NAME is
# needed; the image enumerates {Storm, Embree} by default discovery.
# See build_hdembree.sh.

ARG BASE_IMAGE

FROM ${BASE_IMAGE}

# TEMPORARY: OpenUSD cmake exports reference CONAN_LIB targets the deploy never
# defines (find_package(pxr) consumer, same fixer as MoonRay) — drop when the
# ASWF bases ship corrected exports.
COPY fixers/ /usr/local/aswf/moonray-fixers/
RUN /usr/local/aswf/moonray-fixers/02-openusd-cmake-exports.sh

# TEMPORARY: build hdEmbree into the pristine stack — drop when the ASWF
# base images ship OpenUSD with hdEmbree enabled.
COPY cmake/hdembree-consumer /usr/local/aswf/cmake/hdembree-consumer
COPY build_hdembree.sh /usr/local/aswf/build_hdembree.sh
ARG OPENUSD_TAG
RUN OPENUSD_TAG="${OPENUSD_TAG}" /usr/local/aswf/build_hdembree.sh