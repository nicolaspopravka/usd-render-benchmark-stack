# syntax=docker/dockerfile:1.10

# Byte-pristine <cy> 2027 stack image: base plus the hdEmbree delegate built
# as a USD-enabled install, with the Run-time overlays from fix/rez.  The
# 2027 base ships GNU time and pxr in site-packages, so fix/time and
# fix/pythonpath are NOT carried here (Phase 41 convention).
#
# hdEmbree installs into the compiled-in plugin root (/usr/local/plugin/usd);
# no PXR_PLUGINPATH_NAME is needed, the image enumerates {Storm, Embree} by
# default discovery. See build_hdembree.sh.

ARG BASE_IMAGE

# TEMPORARY: build Rez in this stage — drop when aswf-docker #467 ships it in the base.
FROM ${BASE_IMAGE} AS rez-builder
COPY install_rez.sh /usr/local/bin/install_rez.sh
ENV REZ_INSTALL_DIR=/usr/local/rez
RUN bash -lc 'source /usr/local/bin/install_rez.sh && rez --version'

FROM ${BASE_IMAGE}

# TEMPORARY: Rez from rez-builder — drop when aswf-docker #467 ships it in the base.
COPY --from=rez-builder /usr/local/rez /usr/local/rez

# TEMPORARY: OpenUSD cmake exports reference CONAN_LIB targets the deploy never
# defines (find_package(pxr) consumer, same fixer as MoonRay) — drop when the
# ASWF bases ship corrected exports.
COPY fixers/ /usr/local/aswf/moonray-fixers/
RUN /usr/local/aswf/moonray-fixers/02-openusd-cmake-exports.sh

# TEMPORARY: pxrConfig find_dependency(OpenVDB) needs a findable config on some
# CYs — drop when the ASWF bases ship an OpenVDB cmake config.
RUN /usr/local/aswf/moonray-fixers/04-openvdb-config.sh

# TEMPORARY: build hdEmbree into the pristine stack — drop when the ASWF
# base images ship OpenUSD with hdEmbree enabled.
COPY cmake/hdembree-consumer /usr/local/aswf/cmake/hdembree-consumer
COPY build_hdembree.sh /usr/local/aswf/build_hdembree.sh
ARG OPENUSD_TAG
RUN OPENUSD_TAG="${OPENUSD_TAG}" /usr/local/aswf/build_hdembree.sh
